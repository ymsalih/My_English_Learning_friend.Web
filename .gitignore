# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# GÜVENLİK (KESİNLİKLE GİTHUBA GİTMEMESİ GEREKENLER)
# .env* satırı zaten yukarıda var ama garantiye alıyoruz:
.env.local
.env.development
.env.production
# Eğer yanlışlıkla proje içine indirirseniz diye Firebase Admin JSON dosyaları:
*firebase-adminsdk*.json
*serviceAccount*.json
firebase-credentials.json
iyzico-keys.txt
